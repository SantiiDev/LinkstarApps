# Compilación de PRODUCCIÓN del panel (npm run build:dashboard) — app.linkstarapp.com.
#
# Trackeado en git a propósito, como apps/ventas/.env.production: acá sólo van
# valores públicos. Todo lo que empieza con VITE_ termina dentro del bundle que
# descarga cualquier navegador, así que nada de esto es secreto. La anon key de
# Supabase es pública por diseño (lo que protege los datos es el RLS). NUNCA
# poner acá la service_role ni nada de services/api/.env.

VITE_SUPABASE_URL=https://czdydtkhiqmwujadwlzf.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_CxH121g_jEC1AM5pCXf9ow_oA3TOZbN

# El API todavía no está desplegado. Apunta a donde va a vivir: mientras no
# conteste, las acciones que lo necesitan (conectar Google, responder, el
# checkout) muestran "el servicio no está disponible" en vez de romperse, y el
# día que el API exista no hace falta recompilar el panel.
VITE_API_URL=https://api.linkstarapp.com

# Tiene que coincidir con REDIRECT_DOMAIN del API (ver CLAUDE.md).
VITE_REDIRECT_DOMAIN=l.linkstarapp.com

# Sin API no hay checkout de Mercado Pago: el plan Business se ofrece como
# "Contactar con ventas" hasta que el API esté arriba. Ver lib/config.js.
VITE_BUSINESS_CHECKOUT=off
