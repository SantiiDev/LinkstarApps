# Project Settings → API en el dashboard de Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend de Linkstar (services/api/server.js)
VITE_API_URL=http://localhost:3001

# TEMPORAL: habilita la carga manual de ubicaciones, para poder probar el
# circuito completo (local -> expositor -> escaneo -> ficha de Google) mientras
# el acceso a la API de Google Business Profile sigue en trámite. Dejar vacío o
# sin definir en cualquier entorno que no sea el tuyo. Se borra junto con
# pages/Locations/NewLocationModal.jsx el día que llegue el OAuth.
VITE_ENABLE_MANUAL_LOCATION=

# Dominio grabado en el NFC / impreso en el QR (mismo valor que
# services/api/lib/config.js REDIRECT_DOMAIN). Opcional: si no se define, usa
# l.linkstarapp.com.
VITE_REDIRECT_DOMAIN=l.linkstarapp.com
