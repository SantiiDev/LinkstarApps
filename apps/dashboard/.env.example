# Project Settings → API en el dashboard de Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend de Linkstar (services/api/server.js)
VITE_API_URL=http://localhost:3001

# Dominio grabado en el NFC / impreso en el QR (mismo valor que
# services/api/lib/config.js REDIRECT_DOMAIN). Opcional: si no se define, usa
# l.linkstarapp.com.
VITE_REDIRECT_DOMAIN=l.linkstarapp.com

# Checkout del plan Business (Mercado Pago, vía el API). Opcional, default on.
# Con "off" el plan Business se ofrece como "Contactar con ventas". Existe para
# publicar el panel antes que el API: lo usa .env.production hasta que el API
# esté desplegado. En local dejalo sin definir para poder probar el checkout.
# VITE_BUSINESS_CHECKOUT=off
