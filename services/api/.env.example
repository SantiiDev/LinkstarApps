# Supabase — Project Settings → API en el dashboard de Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role (secret): sólo la usa este backend. Nunca va al frontend ni se commitea con valor real.
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=3001

# Orígenes permitidos por CORS, separados por coma. Esta API atiende a los dos
# frontends: ventas (5174) y dashboard (5173). El primero de la lista es el que
# se usa para las back_urls de Mercado Pago, así que va el de ventas, que es
# donde vive el checkout.
FRONTEND_URL=http://localhost:5174,http://localhost:5173

# URL del dashboard, a donde vuelve el cliente después de autorizar la
# suscripción mensual en Mercado Pago. Opcional: si no se define, lib/config.js
# toma la SEGUNDA entrada de FRONTEND_URL (la convención de este repo es ventas
# primero, dashboard después). No puede ser FRONTEND_URL porque esa apunta al
# sitio de ventas, que es donde vuelve la compra de expositores.
DASHBOARD_URL=http://localhost:5173

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública donde este servicio recibe las notificaciones. Se manda como
# notification_url en cada preapproval, además de lo configurado en el panel de
# MP — en desarrollo la URL es un túnel que cambia en cada reinicio y así no hay
# que reconfigurar el panel cada vez. Termina en /api/webhook/mercadopago.
WEBHOOK_URL=

# Notificaciones de nuevas órdenes (Web3Forms)
WEB3FORMS_KEY=

# Dominio corto grabado en el NFC / impreso en el QR: https://<REDIRECT_DOMAIN>/d/<public_id>
# Opcional: si no se define, lib/config.js usa l.linkstarapp.com. Mismo valor
# que VITE_REDIRECT_DOMAIN en apps/dashboard/.env. Tiene que ser un subdominio
# de linkstarapp.com, que es la única zona propia — el subdominio todavía no
# está creado en Cloudflare.
REDIRECT_DOMAIN=l.linkstarapp.com
