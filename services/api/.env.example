# Supabase — Project Settings → API en el dashboard de Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role (secret): sólo la usa este backend. Nunca va al frontend ni se commitea con valor real.
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=3001

# Orígenes permitidos por CORS, separados por coma. Esta API atiende a los dos
# frontends: ventas (5174) y dashboard (5173). El primero de la lista es el que
# se usa para las back_urls de Mercado Pago, así que va el de ventas, que es
# donde vive el checkout.
FRONTEND_URL=http://localhost:5174,http://localhost:5173

# URL del dashboard, a donde vuelve el cliente después de autorizar la
# suscripción mensual en Mercado Pago. Opcional: si no se define, lib/config.js
# toma la SEGUNDA entrada de FRONTEND_URL (la convención de este repo es ventas
# primero, dashboard después). No puede ser FRONTEND_URL porque esa apunta al
# sitio de ventas, que es donde vuelve la compra de expositores.
DASHBOARD_URL=http://localhost:5173

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública BASE de este servicio, SIN ruta (producción:
# https://api.linkstarapp.com). routes/orders.js le agrega
# /api/webhook/mercadopago y la manda como notification_url en las preferencias
# de compra de expositores. Las SUSCRIPCIONES no la usan: /preapproval acepta
# notification_url pero no la guarda (ver lib/subscriptions.js), así que sus
# notificaciones salen sólo a la URL configurada en el panel de Mercado Pago.
WEBHOOK_URL=

# Avisos a NUESTRA casilla (pedidos nuevos y consultas de contacto) —
# lib/email.js. Con RESEND_API_KEY y SALES_NOTIFY_EMAIL salen por Resend; si
# falta alguna de las dos, por Web3Forms, cuyo plan gratis rechaza los envíos
# desde un servidor: en producción el camino real es Resend.
SALES_NOTIFY_EMAIL=linkstar.app1@gmail.com
WEB3FORMS_KEY=

# Dominio corto grabado en el NFC / impreso en el QR: https://<REDIRECT_DOMAIN>/d/<public_id>
# Opcional: si no se define, lib/config.js usa l.linkstarapp.com. Mismo valor
# que VITE_REDIRECT_DOMAIN en apps/dashboard/.env. Tiene que ser un subdominio
# de linkstarapp.com, que es la única zona propia — el subdominio todavía no
# está creado en Cloudflare.
REDIRECT_DOMAIN=l.linkstarapp.com

# Email transaccional (Resend) — lib/mailer.js. Lo usan los mails al CLIENTE
# (alertas, invitaciones) y, con SALES_NOTIFY_EMAIL definido, también los
# avisos a nuestra casilla.
# Opcional: sin esto los mails se simulan por consola en vez de enviarse, y el
# ejecutor de alertas NO los registra como mandados (así el aviso real sale
# cuando la clave exista). Se saca de resend.com → API Keys.
RESEND_API_KEY=
# Remitente. Tiene que ser de un dominio verificado en Resend; mientras no lo
# esté, Resend sólo deja enviar a la casilla con la que se creó la cuenta.
# El default de lib/mailer.js es el remitente de prueba de Resend.
RESEND_FROM=Linkstar <onboarding@resend.dev>

# Google Business Profile (OAuth 2.0) — lib/googleOAuth.js, routes/google.js,
# routes/googleProfile.js, scripts/sync-google.js. Sin las cuatro, /api/google/* responde 503 y el
# resto del servicio funciona igual.
#
# Consola de Google Cloud → APIs y servicios → Credenciales → ID de cliente de
# OAuth de tipo "Aplicación web". El secret es SECRETO: sólo vive acá, nunca en
# apps/dashboard ni en el repo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tiene que coincidir EXACTO (esquema, host, puerto y path) con una de las URIs
# de redireccionamiento autorizadas del cliente OAuth. En local el puerto es el
# de PORT (3001), no 3000: si no coinciden, el servidor avisa al arrancar.
# Producción: https://api.linkstarapp.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
# Clave AES-256 con la que se cifran los refresh tokens antes de guardarlos en
# Supabase (lib/tokenCrypto.js). 32 bytes en base64; se genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Una clave por entorno. Si se pierde, todas las conexiones dejan de servir y
# cada cliente tiene que reconectar su ficha — guardala junto a la service_role.
GOOGLE_TOKEN_ENC_KEY=

# Gemini (fase 5) — lib/gemini.js, lib/reviewAnalysis.js. Analiza el texto de
# las reseñas de las organizaciones Business: sentimiento, temas y palabras
# clave (0033). Opcional: sin la clave, la lectura de Google sigue igual y las
# reseñas quedan pendientes de análisis hasta que exista.
#
# Google AI Studio → API keys. Usar un proyecto CON FACTURACIÓN: en el nivel
# gratis Google puede usar lo que se le manda para mejorar sus productos, y el
# texto de las reseñas viene de la API de Business Profile, cuya política de
# datos (Limited Use) no permite eso.
GEMINI_API_KEY=
# Opcional. Un modelo «flash-lite» alcanza y es el más barato.
GEMINI_MODEL=gemini-3.5-flash-lite
