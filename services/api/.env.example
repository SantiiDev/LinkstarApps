# Supabase — Project Settings → API en el dashboard de Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role (secret): sólo la usa este backend. Nunca va al frontend ni se commitea con valor real.
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
WEBHOOK_URL=

# Notificaciones de nuevas órdenes (Web3Forms)
WEB3FORMS_KEY=
